/* Luna TUI stylesheet.
 *
 * Consolidated here — not scattered as DEFAULT_CSS strings inside every
 * widget's own .py file — per Textual's own guidance (docs/guide/widgets.md,
 * "Static widget > Default CSS"): DEFAULT_CSS is for widgets meant to be
 * *distributed standalone* (bundled CSS travels with the class, e.g. via
 * PyPI); for an application's own widgets, "it is best to keep your CSS in
 * an external file" — one place to see it all, live-editable, higher
 * cascade specificity than any widget-bundled CSS. Colors below ($bg,
 * $panel, $moon, ...) come from LunaApp.get_theme_variable_defaults()
 * (luna/tui/theme.py) and are already available here without any
 * per-file $var declaration.
 */

/* --- App shell: sidebars + chat column ---------------------------------- */

#sessions-sidebar {
    width: 30;
    background: $panel;
    border-right: solid $border;
}

ChatPane {
    /* Without an explicit width, ChatPane has no basis to share the
       Horizontal row's space with its fixed-width sidebar sibling —
       confirmed empirically via a real pty: ChatPane once claimed the
       *entire* remaining width as if a sibling sidebar didn't exist,
       pushing it (silently, no error, nothing crops or wraps) off past
       the right edge of the screen — not narrow, not hidden, just never
       drawn. `1fr` is what
       lets it actually share the row instead of overflowing past it.
    */
    width: 1fr;
    background: $bg;
}

/* --- Status bar (ChatPane's own child, right under the input) ---------- */

#status-bar {
    /* `height: 1` is border-box (Textual, like CSS, counts a border
       toward the declared height, not on top of it) — a `border-top`
       here once left ZERO rows for the text itself: `.region.height` (1)
       looked fine, but `.size.height` (the actual content box) measured
       0, so the status bar was invisible from day one, well before it
       ever had real content to show. Confirmed empirically via a real
       pty (Textual's headless test driver reports a misleadingly
       normal-looking `.region` for this exact failure — only `.size`
       exposes it). $panel's lighter tone against $bg already reads as a
       distinct strip without a border line.
    */
    height: 1;
    background: $panel;
    color: $moon-dim;
    padding: 0 1;
}

/* --- Chat transcript + message bubbles ---------------------------------- */

ChatPane #transcript {
    height: 1fr;
}

UserMessage {
    color: $moon;
    margin: 1 1 1 1;
    padding: 0;
}

LunaMessage {
    color: $moon;
    margin: 0 1 1 3;
    padding: 0;
}

SystemMessage {
    color: $moon-dim;
    margin: 0 1 1 3;
    padding: 0;
}

ToolRow {
    height: auto;
    margin: 0 1 1 3;
}

ToolRow PulseGlyph {
    margin: 0;
}

ToolRow .tool-detail {
    color: $moon-dim;
}

LunaBanner {
    height: auto;
    padding: 1 0 2 0;
}

/* --- Slash-command autocomplete + input --------------------------------- */

ChatPane #autocomplete {
    /* A *fixed* height, not `auto`/`max-height` — ListView is a
       ScrollableContainer, and its auto-content-height measurement does
       not simply sum its children (confirmed: with 23+ real commands
       populated, it measured to 2 rows regardless of `max-height: 10`,
       rendering as an unreadable sliver). ChatPane.on_input_changed sets
       the actual height reactively, one row per match capped at 10, so a
       broad prefix like "/" doesn't take over the screen.
    */
    height: 10;
    background: $panel;
    border: round $border;
    padding: 0 1;
}

ChatPane #chat-input {
    border: round $border;
}

ChatPane #chat-input:focus {
    border: round $peri;
}

/* --- Shared pulsing indicator (chat "thinking" placeholder + tool rows) - */

PulseGlyph {
    height: 1;
    /* Fallback color for the `animation_level == "none"` static bullet —
       the animated frame overrides this with an explicit Rich style. */
    color: $peri;
    text-style: italic;
}

ChatPane PulseGlyph {
    margin: 0 1 1 2;
}

/* --- Sessions sidebar ---------------------------------------------- */

SessionsSidebar .project-name {
    padding: 0 1;
    color: $moon;
    text-style: bold;
}

SessionsSidebar .project-path {
    /* $moon-dim, not $border: $border on $panel is 3.02:1, below the 4.5:1
       minimum theme.py already sets for persistent secondary text. */
    padding: 0 1 1 1;
    color: $moon-dim;
}

SessionsSidebar #session-list {
    background: $panel;
    /* The default 2-column scrollbar squeezed every row and knocked the
       right-aligned times out of line once the list overflowed. */
    scrollbar-size-vertical: 1;
}

SessionsSidebar ListItem {
    background: $panel;
    padding: 0 1;
}

SessionsSidebar ListItem.session-group {
    /* Uppercase + $moon-dim (8.14:1) separates groups from $moon titles
       without dropping below the contrast minimum like $border did. */
    margin-top: 1;
    color: $moon-dim;
    text-style: none;
}

SessionsSidebar ListItem.session-item.-current {
    background: $peri;
}

SessionsSidebar ListItem.session-item.-current Label {
    color: $bg;
}

SessionsSidebar ListItem.new-session-item .session-title {
    color: $peri;
}

SessionsSidebar _SessionRow,
SessionsSidebar _NewSessionRow {
    height: 1;
    width: 1fr;
}

SessionsSidebar .session-title {
    width: 1fr;
    color: $moon;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

SessionsSidebar .session-time {
    width: auto;
    padding-left: 1;
    color: $moon-dim;
}

/* --- Approval modal ------------------------------------------------------ */

ApprovalModal {
    align: center middle;
}

ApprovalModal > Vertical {
    width: 80%;
    height: auto;
    max-height: 80%;
    background: $bg;
    border: round $peri;
    padding: 1 2;
}

/* --- Command pickers + notices ---------------------------------------- */

ChoiceModal, ConfirmModal {
    align: center middle;
}

ChoiceModal > Vertical, ConfirmModal > Vertical {
    width: 60%;
    height: auto;
    max-height: 70%;
    background: $bg;
    border: round $peri;
    padding: 1 2;
}

ChoiceModal #picker-list {
    height: auto;
    max-height: 20;
    background: $bg;
}

.picker-title {
    text-style: bold;
    padding-bottom: 1;
}

.picker-hint {
    color: $moon-dim;
    padding-top: 1;
}

NoticeRow {
    margin: 0 1 1 3;
}

/* Plan mode: writes are refused, so the input says so at a glance. */
ChatPane.-plan #chat-input,
ChatPane.-plan #chat-input:focus {
    border: round $mauve;
}

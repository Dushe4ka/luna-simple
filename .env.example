# Необязательно: `luna setup` кладёт ключи в ~/.config/luna/credentials.toml.
# Переменные окружения (ниже) всегда важнее сохранённых ключей.
# Задайте ключ того провайдера, которым пользуетесь (по умолчанию — anthropic).

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
PPLX_API_KEY=
CEREBRAS_API_KEY=

# Ollama не требует ключа. При необходимости укажите нестандартный хост:
# OLLAMA_HOST=http://localhost:11434

# Свой OpenAI-совместимый провайдер (vLLM, LM Studio и т. п.) — см. README,
# раздел "Свой OpenAI-совместимый провайдер". Ключ не обязателен для
# локальных серверов без аутентификации.
# MYLOCAL_API_KEY=

# Используется MCP-сервером "github" (luna mcp add github):
# GITHUB_TOKEN=

# Необязательные переопределения Luna (также доступны через флаги CLI / конфиги):
# LUNA_PROVIDER=anthropic
# LUNA_MODEL=
# LUNA_YOLO=0

# Set the key for whichever provider you use (default provider: anthropic).
# Luna reads these from the environment or a local .env you load yourself.

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ollama needs no API key. Optionally point Luna at a non-default host:
# OLLAMA_HOST=http://localhost:11434

# Optional Luna overrides (also settable via CLI flags / config files):
# LUNA_PROVIDER=anthropic
# LUNA_MODEL=
# LUNA_YOLO=0

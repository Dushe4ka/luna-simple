# Необязательно: `luna setup` кладёт ключи в ~/.config/luna/credentials.toml.
# Переменные окружения (ниже) всегда важнее сохранённых ключей.
# Задайте ключ того провайдера, которым пользуетесь (по умолчанию — anthropic).

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ollama не требует ключа. При необходимости укажите нестандартный хост:
# OLLAMA_HOST=http://localhost:11434

# Используется MCP-сервером "github" (luna mcp add github):
# GITHUB_TOKEN=

# Необязательные переопределения Luna (также доступны через флаги CLI / конфиги):
# LUNA_PROVIDER=anthropic
# LUNA_MODEL=
# LUNA_YOLO=0

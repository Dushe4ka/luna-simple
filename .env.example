# Optional: `luna setup` stores keys in ~/.config/luna/credentials.toml instead.
# Environment variables (below) always override the stored keys.
# Set the key for whichever provider you use (default provider: anthropic).

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ollama needs no API key. Optionally point Luna at a non-default host:
# OLLAMA_HOST=http://localhost:11434

# Used by the "github" MCP server (luna mcp add github):
# GITHUB_TOKEN=

# Optional Luna overrides (also settable via CLI flags / config files):
# LUNA_PROVIDER=anthropic
# LUNA_MODEL=
# LUNA_YOLO=0
